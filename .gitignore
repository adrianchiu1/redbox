__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
build/
dist/

# Data layers: raw snapshots are immutable but large; they are versioned by
# hash in the manifest, not committed. manual/ IS committed (hand-keyed CSVs).
data/raw/*
data/standard/*
data/canonical/*
!data/raw/.gitkeep
!data/standard/.gitkeep
!data/canonical/.gitkeep
# §11.6 CSV deliverables double as gate evidence and are committed (the
# parquet twins stay local; everything regenerates via `ggfiscal build`,
# `reconcile`, `validate` from the hash-recorded snapshots):
!data/canonical/*.csv

# Hand-retrieved snapshots (D-S7-001): no machine fetch path exists (obr.uk
# Cloudflare challenge, OQ-6), so unlike refetchable pulls the raw bytes ARE
# committed — the §11.4 store-the-PDF-in-raw rule extended to xlsx.
!data/raw/OBR_EFO_LATEST/
!data/raw/OBR_FRS/
!data/raw/OBR_PSF_DATABANK/
!data/raw/OBR_HIST_PF/
