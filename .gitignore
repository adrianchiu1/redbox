__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
build/
dist/

# Data layers: raw snapshots are immutable but large; they are versioned by
# hash in the manifest, not committed. manual/ IS committed (hand-keyed CSVs).
data/raw/*
data/standard/*
data/canonical/*
!data/raw/.gitkeep
!data/standard/.gitkeep
!data/canonical/.gitkeep
# Small §11.6 deliverables double as gate evidence and are committed
# (regenerable via `ggfiscal reconcile` / `ggfiscal validate`):
!data/canonical/weo_base_bridge.csv
!data/canonical/exceptions.csv
