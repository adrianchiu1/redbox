(function($){
  $(".dropdown-language-item .active-language").click( function($this) {
    if($this.currentTarget.parentElement.parentElement.parentElement.parentElement.classList.contains('open')) {
      $('.dropbutton-wrapper').removeClass('open');
    } else {
      $('.dropbutton-wrapper').addClass('open');
    }
  });
})(jQuery);
