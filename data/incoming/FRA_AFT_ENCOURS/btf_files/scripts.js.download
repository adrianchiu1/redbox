(function ($, Drupal, drupalSettings) {

    'use strict';

    $('document').ready(function () {

      // on place le footer en bas de la page quand le contenu est court
      // recuperation de la taille de chacun des elements
      var windowHeight = $(window).innerHeight(),
          mainHeight = $('main').innerHeight(),
          headerHeight = $('header[role="banner"]').innerHeight(),
          footerHeight = $('footer[role="contentinfo"]').innerHeight(),
          contentHeight = mainHeight + headerHeight,
          bandeauxHeight = headerHeight + footerHeight;

          // si le contenu (header + main) est plus court que la taille de l'ecran
          // on donne une taille minimum au contenu en calculant : taille de l'ecran - (header + footer) - 55px qui correspondent a 20px de marge sous le menu + 32px de padding en bas du footer
          if(contentHeight < windowHeight) {
            $('main').css('min-height', windowHeight - bandeauxHeight - 55);
          }

        var url = window.location.pathname.split('/');
        var locale = url[1];

        // calcul du montant total des encours pour les pages encours détaillé
        $('div.encours-detaille table').each(function (index) {
            var total = 0;
            $('tbody td.views-field-field-encours', this).each(function (index) {
                var encours = $(this).text().trim();
                if (encours === "") {
                    encours = 0;
                } else {
                    if (locale == 'en') {
                        encours = encours.replace(/,/g, "");
                    }
                    encours = encours.replace(/\s/g, "");
                    encours = parseInt(encours, 10);
                }
                total += encours;
            });
            var originalCaption = $('caption', this).text();
            originalCaption = originalCaption.replace(/:/g, "");
            $('caption', this).text(originalCaption);

            if (locale == 'en') {
                total = total.toLocaleString('en-EN');
            } else {
                total = total.toLocaleString('fr-FR');
            }
            $('caption', this).append('<span style="float: right;">' + total + '</span>');
        });


        // formulaire de recherche
        $('.block-search button').on('click', function () {
            $(this).toggleClass('triggered');
            if ($(this).hasClass('triggered')) {
                $(this).removeClass('open').addClass('close');
                $(this).parents('.block-search').addClass('open').find('.mini-form').show();
            } else {
                $(this).removeClass('close').addClass('open');
                $(this).parents('.block-search').removeClass('open').find('.mini-form').hide();
            }
        });
        // $("button.button-search").attr("src","/themes/custom/aft/images/croix.png");


        // menus mobiles
        $('.toggle--menus-rapides').on('click', function () {
            if ($('.toggle--menus-rapides').hasClass('active')) {
                $('.toggle--menus-rapides').removeClass('active');
                $('.acces nav').hide();
            } else {
                $('.toggle--menus-rapides').addClass('active');
                $('.acces nav').show();
            }
        });

        // accordeons
        if ($('html').hasClass('js')) {
            $('.accordion-wrapper > h3').addClass('accordion-title');
            $('.accordion-wrapper .accordion-item').hide();
            $('.accordion-wrapper .accordion-title').on('click', function () {
                if ($(this).hasClass('open')) {
                    $(this).removeClass('open');
                } else {
                    $(this).addClass('open');
                }
                $(this).siblings('.accordion-item').toggle();
            });

            // page archive résultat presse
            $('.view-communiques-de-presse h3').addClass('accordion-title');
            $('.view-communiques-de-presse ul').addClass('accordion-item');
            $('.view-communiques-de-presse .accordion-item').hide();
            $('.view-communiques-de-presse .accordion-title').on('click', function () {
                if ($(this).hasClass('open')) {
                    $(this).removeClass('open');
                } else {
                    $(this).addClass('open');
                }
                $(this).siblings('.accordion-item').toggle();
            })

            // arcordeon page presentation SVT
            $('#block-views-block-communiques-de-presse-svt-block-1 h2').addClass('accordion-title');
            $('#block-views-block-communiques-de-presse-svt-block-1 .view-communiques-de-presse-svt').addClass('accordion-item');
            $('#block-views-block-communiques-de-presse-svt-block-1 .accordion-item').hide();
            $('#block-views-block-communiques-de-presse-svt-block-1 .accordion-title').on('click', function () {
                if ($(this).hasClass('open')) {
                    $(this).removeClass('open');
                } else {
                    $(this).addClass('open');
                }
                $('#block-views-block-communiques-de-presse-svt-block-1 .accordion-item').toggle();
            })
        }

        //boutons radio et checkboxes
        $('input.form-radio').change(function () {
            if ($(this).prop("checked")) {
                $(this).addClass('checked');
            } else {
                $(this).removeClass('checked');
            }
        });

        // bandeau actu defilant - defilement fait en css
        $("#block-actualites .control").click(function () {
            $('#block-actualites .control').toggleClass('pause').toggleClass('play');
            $('#block-actualites .control').parents($('#block-actualites')).find('.slide-wrapper').toggleClass('off');
        });

        /**
         * Bloc de dernieres adjudications - onglets accueil
         **/
        $('#block-dernieresadjudications .block-views-blockdernieres-adjudications-block-dernieres-adjudication-oat h2').addClass('active');
        $('#block-dernieresadjudications .block-views-blockdernieres-adjudications-block-dernieres-adjudication-oat .adjudications').addClass('active');
        $('#block-dernieresadjudications .block-views h2').on('click', function () {
            $('#block-dernieresadjudications .block-views h2').removeClass('active');
            $('#block-dernieresadjudications .block-views h2').siblings('div').find('.adjudications').removeClass('active');
            $(this).addClass('active');
            $(this).siblings('div').find('.adjudications').addClass('active');
        });

        // Apparition du bouton de remonté en haut de page après un peu de scroll
        window.onscroll = function () {
            if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
                $('.backtotop').fadeIn("slow");
            } else {
                $('.backtotop').fadeOut("slow");
            }
        };

        // scollBtn
        function scrollTop(distance) {
            $('html, body').animate({scrollTop: distance}, 'slow');
            return false;
        }

        $("a").on('click', function () {
            var page = $(this).attr('href');
            if (page == "#coefficients_indexation_oati") {
                scrollTop(600);
            } else if (page == "#serie_longue_oati") {
                scrollTop(1200);
            } else if (page == "#rendement_oati") {
                scrollTop(1800);
            } else if (page == "#point_mort_oati") {
                scrollTop(3200);
            }
        });

//datepicker
        var currentYear = (new Date).getFullYear();

        $('.form-item-created input.bef-datepicker').datepicker("option", { changeYear: true, dateFormat:'dd/mm/yy', yearRange: '1996:'+currentYear, maxDate: new Date() });
        $('.form-item-created-1 input.bef-datepicker').datepicker("option", { changeYear: true, dateFormat:'dd/mm/yy', yearRange: '1996:'+currentYear, maxDate: new Date() });


        //encours des fichiers titres
        if ($( "body" ).hasClass('.page-node-type-titre')) {
            var label = $('.page-node-type-titre div.field--name-field-encours .field__label').html();
            $('.page-node-type-titre div.field--name-field-encours .field__label').html(label.replace('*','(€) *'));

        }
    });

})(jQuery, Drupal, drupalSettings);
